# ==============================================================================
# RESOLV - Environment Configuration Template (.env.example)
# IT Incident Management and Resolution System
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate variable values for your local or production environment.
# 3. CRITICAL: NEVER commit real .env files containing credentials into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# In production (SPRING_PROFILES_ACTIVE=prod), CORS_ALLOWED_ORIGINS is strictly enforced
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:80

# ------------------------------------------------------------------------------
# 2. Database Connectivity (MySQL 8.0)
# NOTE: Host machine runs MySQL on port 3306. For Docker containers, use
# DB_HOST=host.docker.internal to connect to host MySQL without port collisions.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=incident_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Production Database Pool Tuning
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. Security & Token Configuration
# Production requirements: At least 256 bits (32 bytes) of high-entropy key
# ------------------------------------------------------------------------------
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Frontend Application Configuration (React 18 / Vite / Nginx)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_PORT=5173
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 5. SonarQube & PostgreSQL Service (Docker Compose Profile: sonarqube)
# ------------------------------------------------------------------------------
SONAR_PORT=9000
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_user_token_here
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar_secure_password
SONAR_DB_NAME=sonar
SONAR_DB_PORT=5432
